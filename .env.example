# Contact form (Resend). Copy to .env or .env.local (both git-ignored) and fill in.
# In production, set the same names as secrets/env vars on the host.

# API key from https://resend.com/api-keys (sending access is enough).
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend.
# Default when unset: DEFAULT_CONTACT_FROM in src/lib/contact.server.ts.
# CONTACT_FROM_EMAIL="Site FutureAI Video <contato@futureailabs.com>"

# Inbox(es) that receive new messages, comma-separated.
# Default when unset: DEFAULT_CONTACT_TO in src/lib/contact.server.ts.
# CONTACT_TO_EMAIL=

# Send an acknowledgement to the visitor ("true" to enable). Only turn this on
# once CONTACT_FROM_EMAIL uses a verified domain.
CONTACT_SEND_CONFIRMATION=false
